// ╔══════════════════════════════════════════════════════════╗
// ║                  Waybar · config.jsonc                   ║
// ╚══════════════════════════════════════════════════════════╝
{
  // ── Bar geometry ──────────────────────────────────────────
  "layer":     "top",
  "position":  "top",
  "passthrough": false,

  "height":      32,
  "spacing":      10,

  "margin-top":    5,
  "margin-left":   5,
  "margin-right":  5,

  // ── Layout ────────────────────────────────────────────────
  "modules-left": [
    "niri/workspaces"
  ],

  "modules-center": [
    "custom/search"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "disk",
    "wireplumber",
    "network",
    "battery",
    "clock"
  ],

  // ╔══════════════════════════════════════════════════════════╗
  // ║  LEFT                                                    ║
  // ╚══════════════════════════════════════════════════════════╝

  // ── CPU ───────────────────────────────────────────────────
  "cpu": {
    "interval":  2,
    "format":    "󰍛 {usage}%",
    "tooltip":   false,
    "on-click":  "kitty --class btop-float -e btop"
  },

  // ── Memory ────────────────────────────────────────────────
  "memory": {
    "interval":      5,
    "format":        "󰘚 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click":      "kitty --class btop-float -e btop"
  },
  // ── Disk (Storage) ────────────────────────────────────────
  "disk": {
    "interval": 30,
    "path": "/", 
    "format": "󰋊 {percentage_used}%",
    "tooltip-format": "{used} / {total} ({percentage_free}% free)",
    "on-click": "kitty --class btop-float -e btop" 
  },
  // ── MPRIS (Media Player) ─────────────────────────────────
  "mpris": {
    "format": "{player_icon}    {status_icon}  ",
    "format-paused": "{player_icon}    {status_icon}  ",
    "format-playing": "{player_icon}    {status_icon}  ",

    "player-icons": {
        "spotify": "",
        "firefox": "󰈹",
        "mpv": "󰐹",
        "default": "󰎆"
    },
    "status-icons": {
        "playing": "",
        "paused": "",
        "stopped": ""
    },
    "tooltip": false,
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next"
  },
  // ── Workspaces ────────────────────────────────────────────
  "niri/workspaces": {
    "all-outputs": false,
    "format": "{value}",
    "format-icons": {
      "active":  "●",
      "default": "○"
    }
  },

  // ╔══════════════════════════════════════════════════════════╗
  // ║  CENTER                                                  ║
  // ╚══════════════════════════════════════════════════════════╝

  // ── Search ────────────────────────────────────────────────
  "custom/search": {
    "format":   "󰍉 Search",
    "tooltip":  false,
    "on-click": "fuzzel --no-icons"
  },

  // ╔══════════════════════════════════════════════════════════╗
  // ║  RIGHT                                                   ║
  // ╚══════════════════════════════════════════════════════════╝

  // ── System tray ───────────────────────────────────────────
  "tray": {
      "icon-size": 12,
      "spacing": 10
  },

  // ── Audio ─────────────────────────────────────────────────

    "wireplumber": {
      "format": "\uf028 {volume}%",
      "format-muted": " {volume}%",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "pavucontrol",
      "tooltip": "true",
      "tooltip-format": "{volume}%"
    },


  // ── Network ───────────────────────────────────────────────
  "network": {
    "format-wifi":        "{icon} Connected",
    "format-ethernet":    "󰲝 Connected",
    "format-disconnected": "󰤫 Disconnected!",
    "format-icons":       ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi":        "{essid} · {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet":    "{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
  },

  // ── Battery ───────────────────────────────────────────────
  "battery": {
    "interval":   30,
    "states": {
      "warning":  30,
      "critical": 15
    },
    "format":          "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged":  "󰚥 {capacity}%",
    "format-icons": [
      "󰁺","󰁻","󰁼","󰁽","󰁾",
      "󰁿","󰂀","󰂁","󰂂","󰁹"
    ],
    "tooltip-format": "{timeTo}\n{power}W"
  },

  // ── Clock ─────────────────────────────────────────────────
  "clock": {
    "format":     "{:%H:%M}",
    "format-alt": "{:%a, %d %b %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode":         "month",
      "mode-mon-col": 3,
      "format": {
        "months":   "<span color='#f9e2af'><b>{}</b></span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today":    "<span background='#f38ba870'><b><u>{}</u></b></span>"
      }
    }
  }
}

